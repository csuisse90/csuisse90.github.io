{
  "name": "logic-gates-ib",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run scripts/content.ts && bun run scripts/siteContext.ts && next build && bun run scripts/serviceWorker.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content": "bun run scripts/content.ts",
    "check": "bun run scripts/content.ts && bun run scripts/checkSnippets.ts && bun run scripts/checkShell.ts && bun run scripts/renderDiagrams.tsx && bun run scripts/checkDiagrams.ts && tsc --noEmit",
    "diagrams": "bun run scripts/renderDiagrams.tsx && bun run scripts/checkDiagrams.ts",
    "browsers": "bun run scripts/checkBrowsers.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@mlc-ai/web-llm": "^0.2.84",
    "@replit/codemirror-vim": "^6.4.0",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.11",
    "next": "^15.1.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
